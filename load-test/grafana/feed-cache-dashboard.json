{
  "title": "Feed Cache",
  "uid": "otus-feed-cache",
  "tags": [
    "otus",
    "highload",
    "cache",
    "feed"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 0,
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "title": "Cache Hit Ratio",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(rate(feed_cache_hits_total[1m])) / (sum(rate(feed_cache_hits_total[1m])) + sum(rate(feed_cache_misses_total[1m])))",
          "legendFormat": "hit ratio"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineInterpolation": "smooth",
            "showPoints": "never"
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Cache Hits / Misses (per sec)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(rate(feed_cache_hits_total[1m]))",
          "legendFormat": "hits"
        },
        {
          "expr": "sum(rate(feed_cache_misses_total[1m]))",
          "legendFormat": "misses"
        },
        {
          "expr": "sum(rate(feed_cache_trims_total[1m]))",
          "legendFormat": "trims"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cps",
          "custom": {
            "lineInterpolation": "smooth",
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Get Feed Latency (p50 / p95 / p99)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(feed_cache_get_feed_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(feed_cache_get_feed_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(feed_cache_get_feed_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineInterpolation": "smooth",
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Cache Warm Latency (p95 / p99)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(feed_cache_warm_feed_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(feed_cache_warm_feed_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineInterpolation": "smooth",
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Fan-out / Add Post Latency (p95)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(feed_cache_fanout_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "fanout p95"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(feed_cache_add_post_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "add_post p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineInterpolation": "smooth",
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "Cache Operation Rate",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 8
      },
      "targets": [
        {
          "expr": "sum(rate(feed_cache_get_feed_duration_seconds_count[1m]))",
          "legendFormat": "get_feed/s"
        },
        {
          "expr": "sum(rate(feed_cache_warm_feed_duration_seconds_count[1m]))",
          "legendFormat": "warm/s"
        },
        {
          "expr": "sum(rate(feed_cache_add_post_duration_seconds_count[1m]))",
          "legendFormat": "add_post/s"
        },
        {
          "expr": "sum(rate(feed_cache_fanout_duration_seconds_count[1m]))",
          "legendFormat": "fanout/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cps",
          "custom": {
            "lineInterpolation": "smooth",
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "Cached Feeds / Posts",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "expr": "feed_cache_total_feeds",
          "legendFormat": "feeds"
        },
        {
          "expr": "feed_cache_total_posts",
          "legendFormat": "posts (rows)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineInterpolation": "smooth",
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "title": "Queues: Fan-out pending / TTL",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 16
      },
      "targets": [
        {
          "expr": "feed_cache_fanout_queue_size",
          "legendFormat": "fanout queue"
        },
        {
          "expr": "feed_cache_ttl_queue_size",
          "legendFormat": "ttl queue"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineInterpolation": "smooth",
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "title": "Feed Endpoint RPS",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 16
      },
      "targets": [
        {
          "expr": "sum by (status) (rate(http_server_requests_seconds_count{uri=\"/post/feed\"}[1m]))",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cps",
          "custom": {
            "lineInterpolation": "smooth",
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "title": "Feed Endpoint Latency (p50 / p95 / p99)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(http_server_requests_seconds_bucket{uri=\"/post/feed\"}[1m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{uri=\"/post/feed\"}[1m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket{uri=\"/post/feed\"}[1m])) by (le))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineInterpolation": "smooth",
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "title": "Feed Writes RPS (fan-out source)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{uri=\"/post/create\"}[1m]))",
          "legendFormat": "post/create"
        },
        {
          "expr": "sum(rate(http_server_requests_seconds_count{uri=~\"/friend/set.*\"}[1m]))",
          "legendFormat": "friend/set"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cps",
          "custom": {
            "lineInterpolation": "smooth",
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    }
  ]
}