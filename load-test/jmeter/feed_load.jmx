      <hashTree>
        <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="pick reader token" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">def tokens = (List) props.get(&quot;feed_tokens&quot;)
if (tokens == null || tokens.isEmpty()) {
  log.error(&quot;feed_tokens is empty, seed did not run&quot;)
  vars.put(&quot;token&quot;, &quot;&quot;)
  return
}
int i = ctx.getThreadNum() % tokens.size()
vars.put(&quot;token&quot;, tokens.get(i))</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
        </JSR223PreProcessor>
        <hashTree/>
