            <stringProp name="JSONPostProcessor.jsonPathExprs">$.user_id</stringProp>
            <stringProp name="JSONPostProcessor.matchNumbers">1</stringProp>
            <stringProp name="JSONPostProcessor.match_numbers"></stringProp>
