      <hashTree>
        <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="use gaga token, pick random peer" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">def t = props.get(&quot;gaga_token&quot;)
vars.put(&quot;token&quot;, t == null ? &quot;&quot; : t.toString())
def peers = (List) props.get(&quot;dialog_peers&quot;)
if (peers == null || peers.isEmpty()) {
  vars.put(&quot;peer_id&quot;, &quot;&quot;)
  return
}
def p = peers.get(new Random().nextInt(peers.size()))
vars.put(&quot;peer_id&quot;, p.id)</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
        </JSR223PreProcessor>
