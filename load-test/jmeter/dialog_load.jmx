        <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="pick peer token" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">def peers = (List) props.get(&quot;dialog_peers&quot;)
if (peers == null || peers.isEmpty()) {
  log.error(&quot;dialog_peers is empty, seed did not run&quot;)
  vars.put(&quot;token&quot;, &quot;&quot;)
  return
}
def p = peers.get(ctx.getThreadNum() % peers.size())
vars.put(&quot;token&quot;, p.token)</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
        </JSR223PreProcessor>
